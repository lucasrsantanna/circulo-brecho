# Exemplo de configuração - Copie para .env e preencha com suas credenciais reais

# === MERCADO PAGO ===
MERCADO_PAGO_PUBLIC_KEY=TEST-sua-chave-publica-aqui
MERCADO_PAGO_ACCESS_TOKEN=TEST-seu-access-token-aqui

# === FIREBASE ===  
FIREBASE_API_KEY=sua-api-key-firebase
FIREBASE_PROJECT_ID=seu-projeto-id

# === CONTATO ===
WHATSAPP_PHONE=5511999999999